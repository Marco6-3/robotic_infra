<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3_mujoco">
  <xacro:arg name="mujoco_model" default="generated/fr3_hand/scene.xml"/>
  <!-- Reuse the official FR3 + Franka Hand kinematics and geometry. -->
  <xacro:include filename="$(find franka_description)/robots/common/franka_robot.xacro"/>
  <xacro:franka_robot
    robot_type="fr3"
    hand="true"
    ee_id="franka_hand"
    arm_prefix=""
    no_prefix="false"
    special_connection=""
    xyz_ee="0 0 0"
    rpy_ee="0 0 ${-pi/4}"
    tcp_xyz="0 0 0.1034"
    tcp_rpy="0 0 0"
    safety_distance="0.0"
    with_sc="false"
    include_self_collision_geometry="true"
    description_pkg="franka_description"
    connected_to="base"/>

  <xacro:macro name="fr3_joint_interface" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
    </hardware>
    <xacro:fr3_joint_interface joint_name="fr3_joint1"/>
    <xacro:fr3_joint_interface joint_name="fr3_joint2"/>
    <xacro:fr3_joint_interface joint_name="fr3_joint3"/>
    <xacro:fr3_joint_interface joint_name="fr3_joint4"/>
    <xacro:fr3_joint_interface joint_name="fr3_joint5"/>
    <xacro:fr3_joint_interface joint_name="fr3_joint6"/>
    <xacro:fr3_joint_interface joint_name="fr3_joint7"/>
    <xacro:fr3_joint_interface joint_name="fr3_finger_joint1"/>
  </ros2_control>
</robot>
